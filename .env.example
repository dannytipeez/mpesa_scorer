# Safaricom Daraja M-Pesa Configuration
# Set these variables in your Render Dashboard -> Environment tab
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=your_daraja_consumer_key_here
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret_here
MPESA_PASSKEY=your_daraja_passkey_here
MPESA_SHORTCODE=5008412
MPESA_PAYMENT_AMOUNT=50
MPESA_CALLBACK_URL=https://your-app-name.onrender.com/api/v1/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
